<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Top Row: Cover Art, Title & Artist, Like Button -->
    <RelativeLayout
        android:id="@+id/widget_top_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/widget_cover_art"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_widget_default_note" />

        <ImageView
            android:id="@+id/widget_btn_like"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Like"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_heart_white" />

        <LinearLayout
            android:id="@+id/widget_info_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@id/widget_btn_like"
            android:layout_toEndOf="@id/widget_cover_art"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_song_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Musicfy"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_song_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="مشغل الموسيقى"
                android:textColor="#B0B0B0"
                android:textSize="13sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Middle Row: High-Precision Interactive Progress Bar & Timestamps -->
    <RelativeLayout
        android:id="@+id/widget_timeline_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_top_container"
        android:layout_marginTop="6dp">

        <!-- Left Time & Rewind 5s Target -->
        <LinearLayout
            android:id="@+id/widget_rewind_wrapper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/widget_pos_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#A0A0A0"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="-5s"
                android:textColor="#66FFFFFF"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Right Time & Forward 5s Target -->
        <LinearLayout
            android:id="@+id/widget_forward_wrapper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:text="+5s"
                android:textColor="#66FFFFFF"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_dur_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="#A0A0A0"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Precision Timeline Touch Bar Container -->
        <RelativeLayout
            android:id="@+id/widget_progress_touch_wrapper"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_below="@id/widget_rewind_wrapper"
            android:gravity="center_vertical">

            <ProgressBar
                android:id="@+id/widget_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_centerVertical="true"
                android:max="1000"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress_track" />

            <!-- 16 Fine-Grained Touch Segments across the bar (Exact percentage seeking) -->
            <LinearLayout
                android:id="@+id/widget_seek_touch_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_seek_01"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Seek 3%" />

                <ImageView
                    android:id="@+id/widget_seek_02"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Seek 9%" />

                <ImageView
                    android:id="@+id/widget_seek_03"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Seek 16%" />

                <ImageView
                    android:id="@+id/widget_seek_04"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Seek 22%" />

                <ImageView
                    android:id="@+id/widget_seek_05"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Seek 28%" />

                <ImageView
                    android:id="@+id/widget_seek_06"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Seek 35%" />

                <ImageView
                    android:id="@+id/widget_seek_07"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Seek 41%" />

                <ImageView
                    android:id="@+id/widget_seek_08"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Seek 47%" />

                <ImageView
                    android:id="@+id/widget_seek_09"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Seek 53%" />

                <ImageView
                    android:id="@+id/widget_seek_10"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Seek 60%" />

                <ImageView
                    android:id="@+id/widget_seek_11"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Seek 66%" />

                <ImageView
                    android:id="@+id/widget_seek_12"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Seek 72%" />

                <ImageView
                    android:id="@+id/widget_seek_13"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Seek 78%" />

                <ImageView
                    android:id="@+id/widget_seek_14"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Seek 85%" />

                <ImageView
                    android:id="@+id/widget_seek_15"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Seek 91%" />

                <ImageView
                    android:id="@+id/widget_seek_16"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Seek 97%" />
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>

    <!-- Bottom Row: Controls (Shuffle, Previous, Play/Pause, Next, Repeat) -->
    <LinearLayout
        android:id="@+id/widget_controls_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_timeline_container"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_btn_shuffle"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Shuffle"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_shuffle_white" />

        <ImageView
            android:id="@+id/widget_btn_prev"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Previous"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_prev" />

        <ImageView
            android:id="@+id/widget_btn_play_pause"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_play_bg"
            android:contentDescription="Play/Pause"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_play" />

        <ImageView
            android:id="@+id/widget_btn_next"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_next" />

        <ImageView
            android:id="@+id/widget_btn_repeat"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Repeat"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_repeat_white" />
    </LinearLayout>

</RelativeLayout>
