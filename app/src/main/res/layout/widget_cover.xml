<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_placeholder_cover" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/w_info"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_pill_dark"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="5dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:id="@+id/w_cover"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="@string/app_name"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_widget_default_note" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/w_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="Musicfy"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/w_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Music player"
                        android:textColor="#B3FFFFFF"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/w_share"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_circle_dark"
                android:contentDescription="Share"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_wg_share" />

            <ImageView
                android:id="@+id/w_like"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_circle_dark"
                android:contentDescription="Like"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_wg_heart_outline" />
        </LinearLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@null" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/w_pos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:text="0:00"
                android:textColor="#E6FFFFFF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/w_dur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="-0:00"
                android:textColor="#E6FFFFFF"
                android:textSize="11sp" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="18dp">

            <ProgressBar
                android:id="@+id/w_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="center_vertical"
                android:max="1000"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress_track" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/w_seek_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Seek" />

                <ImageView
                    android:id="@+id/w_seek_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Seek" />

                <ImageView
                    android:id="@+id/w_seek_3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Seek" />

                <ImageView
                    android:id="@+id/w_seek_4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Seek" />

                <ImageView
                    android:id="@+id/w_seek_5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Seek" />

                <ImageView
                    android:id="@+id/w_seek_6"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Seek" />

                <ImageView
                    android:id="@+id/w_seek_7"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Seek" />

                <ImageView
                    android:id="@+id/w_seek_8"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Seek" />

                <ImageView
                    android:id="@+id/w_seek_9"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Seek" />

                <ImageView
                    android:id="@+id/w_seek_10"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:contentDescription="Seek" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/w_prev"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/widget_circle_dark"
                android:contentDescription="Previous"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_wg_prev" />

            <ImageView
                android:id="@+id/w_play"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/widget_circle_dark"
                android:contentDescription="Play/Pause"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_wg_play" />

            <ImageView
                android:id="@+id/w_next"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/widget_circle_dark"
                android:contentDescription="Next"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_wg_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
